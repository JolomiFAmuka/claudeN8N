# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- Image versions ---------------------------------------------------------
# n8n and the task runner are pinned to the same tag on purpose.
N8N_VERSION=2.36.3

# --- Postgres superuser (used only to bootstrap the DB) ---------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- Postgres non-root user (the account n8n actually connects as) ----------
# Created on first startup by init-data.sh. Note: that script runs ONLY when
# the db_storage volume is empty. Changing these later has no effect unless
# you also drop the volume (docker compose down -v).
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=change-me

# --- Shared secret between n8n and the task runner --------------------------
# Generate with:  openssl rand -hex 32
RUNNERS_AUTH_TOKEN=replace-me-openssl-rand-hex-32

# --- Credential encryption key ----------------------------------------------
# Generate with:  openssl rand -hex 32
# KEEP A BACKUP. Every credential stored in n8n is encrypted with this key.
# Lose it and the credentials in the n8n_storage volume are unrecoverable.
N8N_ENCRYPTION_KEY=replace-me-openssl-rand-hex-32

# --- Timezone ---------------------------------------------------------------
# GENERIC_TIMEZONE controls what schedule/cron triggers use. Without it n8n
# runs them on UTC.
GENERIC_TIMEZONE=America/Winnipeg
TZ=America/Winnipeg

# --- Instance AI: code sandbox ----------------------------------------------
# Shared secrets for the sandbox-api / sandbox-runner-1 pair.
# Generate each with:  openssl rand -hex 32
SANDBOX_API_KEYS=replace-me-openssl-rand-hex-32
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-me-openssl-rand-hex-32
SANDBOX_API_RUNNER_API_KEY=replace-me-openssl-rand-hex-32

# MUST be identical to a value in SANDBOX_API_KEYS above, or n8n gets 401s
# from the sandbox. Service URL in the UI is http://sandbox-api:8080
N8N_INSTANCE_AI_SANDBOX_API_KEY=replace-me-same-as-SANDBOX_API_KEYS

# --- Instance AI: web search ------------------------------------------------
SEARXNG_SECRET=replace-me-openssl-rand-hex-32
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# --- Instance AI: model -----------------------------------------------------
# Format: provider/model. Providers: anthropic, openai, openrouter.
N8N_INSTANCE_AI_MODEL=anthropic/claude-opus-4-8
# Your own provider key — required for the AI Assistant. Anthropic keys begin
# with sk-ant-. Leave blank to run the stack without the Assistant.
N8N_INSTANCE_AI_MODEL_API_KEY=

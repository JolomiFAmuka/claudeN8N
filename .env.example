# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- Image versions ---------------------------------------------------------
# n8n and the task runner are pinned to the same tag on purpose.
N8N_VERSION=2.36.3

# --- Postgres superuser (used only to bootstrap the DB) ---------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- Postgres non-root user (the account n8n actually connects as) ----------
# Created on first startup by init-data.sh. Note: that script runs ONLY when
# the db_storage volume is empty. Changing these later has no effect unless
# you also drop the volume (docker compose down -v).
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=change-me

# --- Shared secret between n8n and the task runner --------------------------
# Generate with:  openssl rand -hex 32
RUNNERS_AUTH_TOKEN=replace-me-openssl-rand-hex-32

# --- Credential encryption key ----------------------------------------------
# Generate with:  openssl rand -hex 32
# KEEP A BACKUP. Every credential stored in n8n is encrypted with this key.
# Lose it and the credentials in the n8n_storage volume are unrecoverable.
N8N_ENCRYPTION_KEY=replace-me-openssl-rand-hex-32

# --- Timezone ---------------------------------------------------------------
# GENERIC_TIMEZONE controls what schedule/cron triggers use. Without it n8n
# runs them on UTC.
GENERIC_TIMEZONE=America/Winnipeg
TZ=America/Winnipeg
